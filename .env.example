# NVD API key (free): https://nvd.nist.gov/developers/request-an-api-key
# Without it CVE lookups still work but are rate-limited to 5 requests / 30 s.
NVD_API_KEY=

# Name recorded as the operator on scans and status changes
ENSAT_OPERATOR=

# Optional overrides
# ENSAT_DATA_DIR=./data
# ENSAT_REPORT_DIR=./reports
# ENSAT_LOG_DIR=./logs
# ENSAT_SCOPE_FILE=./scope.txt
# ENSAT_MAX_HOSTS=4096
# ENSAT_SCAN_TIMEOUT=1800
# ENSAT_OFFLINE=0            # 1 = never call NVD/EPSS/KEV (cached data only)
